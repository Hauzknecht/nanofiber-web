---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/translations';
import { useT, formatDateShort } from '../i18n/translations';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = useT(lang);

const collection = lang === 'en' ? 'blog-en' : 'blog-cs';
const allPosts   = await getCollection(collection, ({ data }) => !data.draft);
const posts      = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section class="blog-section">
  <div class="section-header">
    <h2 class="section-title">{tr.blog.section_title}</h2>
    <a class="btn-ghost" href={`/${lang}/blog`}>{tr.blog.all_articles}</a>
  </div>

  <div class="blog-grid">
    {posts.map(post => (
      <a class="blog-card" href={`/${lang}/blog/${post.slug}`}>
        <div class="blog-date">{formatDateShort(post.data.date, lang)}</div>
        <div class="blog-title">{post.data.title}</div>
        <div class="blog-excerpt">{post.data.excerpt}</div>
        <span class="tag">{post.data.tag}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .blog-section { border-bottom: var(--border); }
  .section-header {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 1rem;
    padding: 2rem var(--section-px) 1.25rem; border-bottom: var(--border);
  }
  .section-title { font-family: var(--serif); font-size: clamp(1.4rem, 3vw, 1.8rem); font-weight: 300; color: var(--ink); }

  .blog-grid { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 600px) { .blog-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 900px) { .blog-grid { grid-template-columns: 1fr 1fr 1fr; } }

  .blog-card { display: block; padding: 1.75rem var(--section-px); border-bottom: var(--border); text-decoration: none; transition: background 0.2s; }
  @media (min-width: 600px) {
    .blog-card { border-right: var(--border); }
    .blog-card:nth-child(2n) { border-right: none; }
  }
  @media (min-width: 900px) {
    .blog-card:nth-child(2n) { border-right: var(--border); }
    .blog-card:nth-child(3n) { border-right: none; }
    .blog-card { border-bottom: none; }
  }
  .blog-card:hover { background: rgba(59,74,62,0.04); }

  .blog-date { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 0.75rem; }
  .blog-title { font-family: var(--serif); font-size: 1.2rem; font-weight: 400; line-height: 1.3; color: var(--ink); margin-bottom: 0.75rem; }
  .blog-excerpt { font-size: 13px; color: var(--ink-muted); line-height: 1.65; margin-bottom: 1rem; }
</style>
