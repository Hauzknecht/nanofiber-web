---
interface BlogPost {
  slug: string;
  title: string;
  date: string;
  excerpt: string;
  tag: string;
}

interface Props {
  posts?: BlogPost[];
}

const { posts = [
  {
    slug: "nanofibers-vs-sheet-masks",
    title: "Why nanofibers could replace conventional face masks",
    date: "March 2025",
    excerpt: "Sheet masks are a $1.5B market. But their delivery efficiency is surprisingly limited. Here's what nanofibers change.",
    tag: "Industry",
  },
  {
    slug: "electrospinning-parameters",
    title: "Electrospinning parameters for cosmetic-grade fibers",
    date: "January 2025",
    excerpt: "A practical guide to voltage, flow rate, and collector distance when working with skin-compatible polymers.",
    tag: "Technical",
  },
  {
    slug: "retinol-encapsulation",
    title: "Retinol encapsulation: the nanofiber approach",
    date: "November 2024",
    excerpt: "Retinol is notoriously unstable. This is how nanofiber matrices offer a novel stabilisation strategy.",
    tag: "Research",
  },
]} = Astro.props;
---

<section class="blog-section">
  <div class="section-header">
    <h2 class="section-title">From the research log</h2>
    <a class="btn-ghost" href="/blog">All posts</a>
  </div>

  <div class="blog-grid">
    {posts.map(post => (
      <a class="blog-card" href={`/blog/${post.slug}`}>
        <div class="blog-date">{post.date}</div>
        <div class="blog-title">{post.title}</div>
        <div class="blog-excerpt">{post.excerpt}</div>
        <span class="tag">{post.tag}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .blog-section {
    border-bottom: var(--border);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 2rem var(--section-px) 1.25rem;
    border-bottom: var(--border);
  }

  .section-title {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 300;
    color: var(--ink);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 600px) {
    .blog-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 900px) {
    .blog-grid { grid-template-columns: 1fr 1fr 1fr; }
  }

  .blog-card {
    display: block;
    padding: 1.75rem var(--section-px);
    border-bottom: var(--border);
    border-right: none;
    text-decoration: none;
    transition: background 0.2s;
    cursor: pointer;
  }

  @media (min-width: 600px) {
    .blog-card { border-right: var(--border); }
    .blog-card:nth-child(2n) { border-right: none; }
  }

  @media (min-width: 900px) {
    .blog-card:nth-child(2n) { border-right: var(--border); }
    .blog-card:nth-child(3n) { border-right: none; }
    .blog-card { border-bottom: none; }
  }

  .blog-card:hover {
    background: rgba(59, 74, 62, 0.04);
  }

  .blog-date {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.75rem;
  }

  .blog-title {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  .blog-excerpt {
    font-size: 13px;
    color: var(--ink-muted);
    line-height: 1.65;
    margin-bottom: 1rem;
  }
</style>
