---
import type { Lang } from '../i18n/translations';
import { useT } from '../i18n/translations';

interface Props {
  lang:     Lang;
  lat?:     number;
  lng?:     number;
  cityName?: string;
  country?:  string;
}

const {
  lang,
  lat      = 49.1951,
  lng      = 16.6068,
  cityName = 'Brno',
  country  = 'Czech Republic',
} = Astro.props;

const tr = useT(lang);
const headline = tr.location.headline
  .replace('{city}', cityName)
  .replace('{country}', country);
---

<section class="location-section">
  <div class="location-info">
    <p class="section-label">{tr.location.label}</p>
    <h2 class="location-headline" set:html={headline} />
    <p class="location-blurb">{tr.location.blurb}</p>
    <a class="btn-primary" href={`/${lang}/contact`}>{tr.location.cta}</a>
  </div>
  <div class="map-wrap" id="map" aria-label={`Map showing ${cityName}`}></div>
</section>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="" is:inline></script>

<script define:vars={{ lat, lng, cityName }}>
  document.addEventListener('DOMContentLoaded', () => {
    const mapEl = document.getElementById('map');
    if (!mapEl || typeof L === 'undefined') return;
    const map = L.map('map', { center: [lat, lng], zoom: 7, scrollWheelZoom: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18,
    }).addTo(map);
    const icon = L.divIcon({
      className: '',
      html: `<div style="width:14px;height:14px;background:#3B4A3E;border:2px solid #F7F4EE;border-radius:50%;box-shadow:0 0 0 1px #3B4A3E"></div>`,
      iconSize: [14, 14], iconAnchor: [7, 7],
    });
    L.marker([lat, lng], { icon }).addTo(map)
      .bindPopup(`<strong style="font-family:Georgia,serif">${cityName}</strong>`, { closeButton: false })
      .openPopup();
  });
</script>

<style>
  .location-section { display: grid; grid-template-columns: 1fr; grid-template-rows: auto 300px; border-bottom: var(--border); }
  @media (min-width: 768px) { .location-section { grid-template-columns: 1fr 1fr; grid-template-rows: unset; min-height: 360px; } }

  .location-info {
    padding: var(--sp-8) var(--section-px);
    display: flex; flex-direction: column; justify-content: center; gap: var(--sp-4);
    border-bottom: var(--border);
  }
  @media (min-width: 768px) { .location-info { border-bottom: none; border-right: var(--border); } }

  .location-headline { font-family: var(--serif); font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 300; line-height: 1.18; color: var(--ink); }
  .location-headline :global(em) { font-style: italic; color: var(--accent); }
  .location-blurb { font-size: 14px; color: var(--ink-muted); line-height: 1.75; max-width: 360px; font-weight: 300; }

  .map-wrap { width: 100%; height: 100%; min-height: 300px; background: #e8e6df; z-index: 1; }
</style>
