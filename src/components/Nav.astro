---
import type { Lang } from '../i18n/translations';
import { useT, alternatePath } from '../i18n/translations';

interface Props {
  lang:     Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const tr = useT(lang);

const links = [
  { label: tr.nav.research,     href: `/${lang}/research`     },
  { label: tr.nav.publications, href: `/${lang}/publications`  },
  { label: tr.nav.consulting,   href: `/${lang}/consulting`    },
  { label: tr.nav.blog,         href: `/${lang}/blog`          },
  { label: tr.nav.contact,      href: `/${lang}/contact`       },
];

// Build the exact alternate-language URL for the current page
// e.g. /en/blog/my-post  →  /cs/blog/my-post
const enPath = lang === 'en' ? pathname : alternatePath(pathname, lang);
const csPath = lang === 'cs' ? pathname : alternatePath(pathname, lang);
---

<nav class="nav">
  <a class="nav-logo" href={`/${lang}/`}>
    Martina Říhová <span>/ {lang === 'en' ? 'Research' : 'Výzkum'}</span>
  </a>

  <ul class="nav-links">
    {links.map(link => (
      <li>
        <a
          href={link.href}
          class:list={['nav-link', { active: pathname.startsWith(link.href) }]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <div class="nav-lang">
    <a href={enPath} class:list={['lang-btn', { active: lang === 'en' }]}>EN</a>
    <a href={csPath} class:list={['lang-btn', { active: lang === 'cs' }]}>CS</a>
  </div>

  <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mobile-drawer" id="drawer" aria-hidden="true">
  <ul class="mobile-links">
    {links.map(link => (
      <li><a href={link.href} class="mobile-link">{link.label}</a></li>
    ))}
  </ul>
  <div class="mobile-lang">
    <a href={enPath} class:list={['lang-btn', { active: lang === 'en' }]}>EN</a>
    <a href={csPath} class:list={['lang-btn', { active: lang === 'cs' }]}>CS</a>
  </div>
</div>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem var(--section-px);
    border-bottom: var(--border);
    position: sticky;
    top: 0;
    background: var(--cream);
    z-index: 100;
    gap: 1rem;
  }
  .nav-logo {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .nav-logo span { font-weight: 300; font-style: italic; color: var(--ink-muted); }

  .nav-links { display: none; list-style: none; gap: 1.75rem; }
  @media (min-width: 900px) { .nav-links { display: flex; } }

  .nav-link {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.2s;
    font-weight: 400;
  }
  .nav-link:hover, .nav-link.active { color: var(--ink); }

  .nav-lang { display: none; gap: 0.4rem; }
  @media (min-width: 900px) { .nav-lang { display: flex; } }

  .lang-btn {
    background: none;
    border: var(--border);
    padding: 4px 10px;
    font-family: var(--sans);
    font-size: 11px;
    cursor: pointer;
    color: var(--ink-muted);
    border-radius: 2px;
    letter-spacing: 0.08em;
    transition: all 0.2s;
    text-decoration: none;
    font-weight: 400;
  }
  .lang-btn.active, .lang-btn:hover {
    background: var(--ink);
    color: var(--cream);
    border-color: var(--ink);
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: auto;
  }
  .hamburger span {
    display: block; width: 22px; height: 1px;
    background: var(--ink); transition: all 0.25s; transform-origin: center;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  @media (min-width: 900px) { .hamburger { display: none; } }

  .mobile-drawer {
    display: none;
    flex-direction: column;
    background: var(--cream);
    border-bottom: var(--border);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }
  .mobile-drawer.open { display: flex; max-height: 400px; }
  @media (min-width: 900px) { .mobile-drawer { display: none !important; } }

  .mobile-links { list-style: none; display: flex; flex-direction: column; }
  .mobile-link {
    display: block; padding: 1rem var(--section-px);
    font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-muted); text-decoration: none; border-bottom: var(--border);
    transition: color 0.2s, background 0.2s;
  }
  .mobile-link:hover { color: var(--ink); background: var(--accent-light); }
  .mobile-lang { display: flex; gap: 0.5rem; padding: 1rem var(--section-px); }
</style>

<script>
  const btn    = document.getElementById('hamburger');
  const drawer = document.getElementById('drawer');
  btn?.addEventListener('click', () => {
    const isOpen = drawer?.classList.toggle('open');
    btn.classList.toggle('open', isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
    drawer?.setAttribute('aria-hidden', String(!isOpen));
  });
  drawer?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      drawer.classList.remove('open');
      btn?.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
