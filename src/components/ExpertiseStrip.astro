---
import type { Lang } from '../i18n/translations';
import { useT } from '../i18n/translations';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = useT(lang);
---

<div class="expertise-strip">
  {tr.expertise.map(item => (
    <div class="expertise-item">
      <span class="expertise-num">{item.num}</span>
      <div class="expertise-title">{item.title}</div>
      <div class="expertise-desc">{item.desc}</div>
    </div>
  ))}
</div>

<style>
  .expertise-strip { display: grid; grid-template-columns: 1fr 1fr; border-bottom: var(--border); }
  @media (min-width: 900px) { .expertise-strip { grid-template-columns: repeat(4, 1fr); } }

  .expertise-item { padding: 2rem var(--section-px); border-right: var(--border); border-bottom: var(--border); }
  .expertise-item:nth-child(2n) { border-right: none; }
  @media (min-width: 900px) {
    .expertise-item { border-bottom: none; }
    .expertise-item:nth-child(2n) { border-right: var(--border); }
    .expertise-item:nth-child(4n) { border-right: none; }
  }

  .expertise-num { font-family: var(--serif); font-size: 2rem; font-weight: 300; color: var(--ink-faint); display: block; margin-bottom: 0.75rem; line-height: 1; }
  .expertise-title { font-size: 13px; font-weight: 500; color: var(--ink); letter-spacing: 0.04em; margin-bottom: 0.5rem; }
  .expertise-desc { font-size: 12px; color: var(--ink-muted); line-height: 1.65; }
</style>
