---
import type { Lang } from '../i18n/translations';
import { useT } from '../i18n/translations';

interface Props {
  lang:        Lang;
  institution: string;
  location:    string;
  field:       string;
  photoSrc?:   string;
  photoAlt?:   string;
}

const {
  lang,
  institution = 'Your University',
  location    = 'Czech Republic',
  field       = 'Nanotechnology · Cosmetics',
  photoSrc,
  photoAlt = 'Portrait photo',
} = Astro.props;

const tr = useT(lang);
---

<section class="about">
  <div class="about-left">
    <div>
      <p class="section-label">{tr.about.label}</p>
      <h2 class="about-headline" set:html={tr.about.headline} />
    </div>
    <div class="portrait-wrap">
      {photoSrc
        ? <img src={photoSrc} alt={photoAlt} class="portrait-img" />
        : <div class="portrait-placeholder">Photo</div>
      }
    </div>
  </div>

  <div class="about-right">
    {tr.about.body.map(para => (
      <p class="about-body" set:html={para} />
    ))}
    <div class="affiliation-row">
      <div class="affiliation">
        <div class="affiliation-label">{tr.about.institution_label}</div>
        <div class="affiliation-value">{institution}</div>
      </div>
      <div class="affiliation">
        <div class="affiliation-label">{tr.about.location_label}</div>
        <div class="affiliation-value">{location}</div>
      </div>
      <div class="affiliation">
        <div class="affiliation-label">{tr.about.field_label}</div>
        <div class="affiliation-value">{field}</div>
      </div>
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: 1fr; border-bottom: var(--border); }
  @media (min-width: 768px) { .about { grid-template-columns: 2fr 3fr; } }

  .about-left {
    padding: var(--sp-8) var(--section-px) var(--sp-4);
    display: flex; flex-direction: column; gap: var(--sp-4);
    border-bottom: var(--border);
  }
  @media (min-width: 768px) {
    .about-left { border-bottom: none; border-right: var(--border); padding: var(--sp-8) var(--section-px); justify-content: space-between; }
  }

  .about-headline { font-family: var(--serif); font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 300; line-height: 1.15; color: var(--ink); margin-top: var(--sp-2); }
  .about-headline :global(em) { font-style: italic; color: var(--accent); }

  .portrait-wrap { max-width: 240px; }
  .portrait-img { width: 100%; border-radius: 2px; aspect-ratio: 3/4; object-fit: cover; }
  .portrait-placeholder {
    width: 100%; aspect-ratio: 3/4; background: var(--ink-faint); border-radius: 2px;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: white; opacity: 0.6;
  }

  .about-right { padding: var(--sp-6) var(--section-px) var(--sp-8); display: flex; flex-direction: column; justify-content: center; }
  @media (min-width: 768px) { .about-right { padding: var(--sp-8) var(--section-px); } }

  .about-body { font-size: 15px; line-height: 1.85; color: var(--ink-muted); max-width: 540px; margin-bottom: var(--sp-4); font-weight: 300; }
  .about-body :global(strong) { color: var(--ink); font-weight: 500; }

  .affiliation-row { display: flex; flex-wrap: wrap; gap: var(--sp-4); padding-top: var(--sp-4); border-top: var(--border); }
  .affiliation { min-width: 120px; }
  .affiliation-label { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 0.35rem; }
  .affiliation-value { font-size: 14px; font-weight: 400; color: var(--ink); }
</style>
