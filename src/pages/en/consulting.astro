---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useT } from '../../i18n/translations';

const lang = 'en' as const;
const tr = useT(lang);
---

<BaseLayout lang={lang} title="Consulting — Martina Říhová" description="Scientific consulting and R&D advisory for cosmetic companies exploring nanofiber technology.">

  <div class="consulting-page">

    <!-- Header -->
    <header class="page-header">
      <p class="eyebrow">Work with me</p>
      <h1 class="page-title">Turning science into <em>products.</em></h1>
      <p class="page-intro">I work with cosmetic brands, ingredient companies, and startups as a scientific consultant — helping teams navigate the technical complexity of nanofiber formulation from early concept through to prototype.</p>
    </header>

    <!-- Services -->
    <div class="services-grid">
      <div class="service-card">
        <span class="service-num">01</span>
        <h2 class="service-title">R&D Advisory</h2>
        <p class="service-desc">Expert guidance on electrospinning processes, polymer selection, and formulation design. Ideal for teams building new delivery systems or optimising existing ones.</p>
      </div>
      <div class="service-card">
        <span class="service-num">02</span>
        <h2 class="service-title">Technical Reports</h2>
        <p class="service-desc">Literature reviews, feasibility assessments, and white papers on nanofiber cosmetics topics. Suitable for internal strategy or regulatory submission support.</p>
      </div>
      <div class="service-card">
        <span class="service-num">03</span>
        <h2 class="service-title">Workshop & Training</h2>
        <p class="service-desc">Hands-on or remote sessions for R&D teams. Topics range from electrospinning fundamentals to advanced characterisation techniques for cosmetic-grade fibers.</p>
      </div>
      <div class="service-card">
        <span class="service-num">04</span>
        <h2 class="service-title">Advisory Board</h2>
        <p class="service-desc">Ongoing scientific advisory relationship. Monthly consultations, literature monitoring, and strategic input on innovation roadmaps.</p>
      </div>
    </div>

    <!-- Ideal for + CTA -->
    <div class="bottom-row">
      <div class="ideal-for">
        <p class="section-label">Ideal for</p>
        <ul class="ideal-list">
          <li>Cosmetic brands exploring active delivery innovation</li>
          <li>Ingredient suppliers developing nanofiber raw materials</li>
          <li>Biotech and femtech startups in the skincare space</li>
          <li>Investors needing scientific due diligence</li>
        </ul>
      </div>

      <div class="cta-box">
        <p class="section-label">Start a conversation</p>
        <h3 class="cta-headline">Interested in working together?</h3>
        <p class="cta-desc">Tell me about your project and I'll get back to you within 48 hours.</p>
        <a class="btn-primary" href="/en/contact">Send a message</a>
      </div>
    </div>

  </div>

</BaseLayout>

<style>
  .consulting-page { max-width: 960px; margin: 0 auto; }

  .page-header {
    padding: var(--sp-8) var(--section-px) var(--sp-6);
    border-bottom: var(--border);
    display: flex; flex-direction: column; gap: var(--sp-3);
    max-width: 680px;
  }
  .page-title {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 300; line-height: 1.05; color: var(--ink);
  }
  .page-title em { font-style: italic; color: var(--accent); }
  .page-intro { font-size: 15px; color: var(--ink-muted); line-height: 1.8; font-weight: 300; }

  /* Services grid */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: var(--border);
  }
  @media (max-width: 600px) { .services-grid { grid-template-columns: 1fr; } }

  .service-card {
    padding: var(--sp-6) var(--section-px);
    border-right: var(--border);
    border-bottom: var(--border);
    display: flex; flex-direction: column; gap: 0.75rem;
  }
  .service-card:nth-child(2n) { border-right: none; }
  .service-card:nth-child(3),
  .service-card:nth-child(4) { border-bottom: none; }
  @media (max-width: 600px) {
    .service-card { border-right: none; }
    .service-card:nth-child(4) { border-bottom: none; }
    .service-card:nth-child(3) { border-bottom: var(--border); }
  }

  .service-num {
    font-family: var(--serif); font-size: 2rem;
    font-weight: 300; color: var(--ink-faint); line-height: 1;
  }
  .service-title { font-size: 15px; font-weight: 500; color: var(--ink); letter-spacing: 0.02em; }
  .service-desc { font-size: 13px; color: var(--ink-muted); line-height: 1.7; }

  /* Bottom row */
  .bottom-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 600px) { .bottom-row { grid-template-columns: 1fr; } }

  .ideal-for {
    padding: var(--sp-6) var(--section-px);
    border-right: var(--border);
  }
  @media (max-width: 600px) { .ideal-for { border-right: none; border-bottom: var(--border); } }

  .ideal-list {
    list-style: none; display: flex; flex-direction: column; gap: 0.75rem;
  }
  .ideal-list li {
    font-size: 14px; color: var(--ink-muted); line-height: 1.5;
    padding-left: 1.25rem; position: relative;
  }
  .ideal-list li::before {
    content: '—'; position: absolute; left: 0;
    color: var(--ink-faint); font-size: 12px;
  }

  .cta-box {
    padding: var(--sp-6) var(--section-px);
    display: flex; flex-direction: column; gap: 0.75rem;
    justify-content: center;
    background: var(--accent-light);
  }
  .cta-headline { font-family: var(--serif); font-size: 1.4rem; font-weight: 300; color: var(--ink); }
  .cta-desc { font-size: 13px; color: var(--ink-muted); line-height: 1.65; }
</style>
