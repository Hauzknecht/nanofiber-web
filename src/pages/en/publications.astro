---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useT } from '../../i18n/translations';

const lang = 'en' as const;
const tr = useT(lang);

const pubEntries = await getCollection('publications');
const publications = pubEntries.map(e => e.data).sort((a, b) => b.year - a.year);

// Group by year
const byYear = publications.reduce((acc, pub) => {
  const y = String(pub.year);
  if (!acc[y]) acc[y] = [];
  acc[y].push(pub);
  return acc;
}, {} as Record<string, typeof publications>);

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout lang={lang} title="Publications — Martina Říhová" description="Peer-reviewed articles, conference papers and other scientific output by Martina Říhová.">

  <div class="pub-page">

    <header class="page-header">
      <p class="eyebrow">Scientific output</p>
      <h1 class="page-title">Publications & <em>Research.</em></h1>
      <p class="page-desc">Peer-reviewed articles, conference contributions, and other scientific outputs.</p>
    </header>

    <div class="pub-list">
      {years.map(year => (
        <div class="year-group">
          <div class="year-label">{year}</div>
          <div class="year-pubs">
            {byYear[year].map(pub => (
              <div class="pub-card">
                <div class="pub-title">{pub.title}</div>
                <div class="pub-authors">{pub.authors}</div>
                {pub.abstract && (
                  <details class="pub-abstract">
                    <summary>Abstract</summary>
                    <p>{pub.abstract}</p>
                  </details>
                )}
                {pub.url && (
                  <a class="pub-link" href={pub.url} target="_blank" rel="noopener noreferrer">
                    View publication →
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>

</BaseLayout>

<style>
  .pub-page { max-width: 860px; margin: 0 auto; }

  .page-header {
    padding: var(--sp-8) var(--section-px) var(--sp-6);
    border-bottom: var(--border);
    display: flex; flex-direction: column; gap: var(--sp-2);
  }
  .page-title {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 300; line-height: 1.05; color: var(--ink);
  }
  .page-title em { font-style: italic; color: var(--accent); }
  .page-desc { font-size: 15px; color: var(--ink-muted); line-height: 1.75; font-weight: 300; }

  .pub-list { display: flex; flex-direction: column; }

  .year-group {
    display: grid;
    grid-template-columns: 80px 1fr;
    border-bottom: var(--border);
  }
  @media (max-width: 500px) {
    .year-group { grid-template-columns: 1fr; }
  }

  .year-label {
    font-family: var(--serif);
    font-size: 1.6rem; font-weight: 300; color: var(--ink-faint);
    padding: var(--sp-6) var(--section-px) var(--sp-6) var(--section-px);
    border-right: var(--border);
    line-height: 1;
  }
  @media (max-width: 500px) {
    .year-label {
      padding: var(--sp-4) var(--section-px) 0;
      border-right: none; font-size: 1.2rem;
    }
  }

  .year-pubs { display: flex; flex-direction: column; }

  .pub-card {
    padding: var(--sp-4) var(--section-px);
    border-bottom: var(--border);
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .pub-card:last-child { border-bottom: none; }

  .pub-title {
    font-family: var(--serif);
    font-size: 1.15rem; font-weight: 400;
    line-height: 1.3; color: var(--ink);
  }
  .pub-authors {
    font-size: 13px; color: var(--ink-muted);
    letter-spacing: 0.02em;
  }

  .pub-abstract {
    margin-top: 0.25rem;
  }
  .pub-abstract summary {
    font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent); cursor: pointer; user-select: none;
    list-style: none; display: inline-flex; align-items: center; gap: 0.4rem;
  }
  .pub-abstract summary::after { content: '+'; font-size: 14px; transition: transform 0.2s; }
  .pub-abstract[open] summary::after { content: '−'; }
  .pub-abstract p {
    font-size: 13px; color: var(--ink-muted); line-height: 1.7;
    margin-top: 0.75rem; max-width: 600px;
  }

  .pub-link {
    display: inline-block; margin-top: 0.25rem;
    font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent); text-decoration: none; transition: opacity 0.2s;
  }
  .pub-link:hover { opacity: 0.7; }
</style>
