---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'en' as const;
---

<BaseLayout lang={lang} title="Contact — Martina Říhová & Jan Macák" description="Get in touch for collaboration, consulting inquiries, or press.">

  <div class="contact-page">

    <div class="contact-left">
      <header class="page-header">
        <p class="eyebrow">Get in touch</p>
        <h1 class="page-title">Let's <em>collaborate.</em></h1>
        <p class="page-intro">Whether you're interested in a consulting project, a research collaboration, an advisory role, or just want to talk nanofibers — I'd love to hear from you.</p>
      </header>

      <!-- Form -->
      <!-- 
        Cloudflare Pages Forms: just add data-static-form-name and it works.
        Alternatively use any free form backend: Formspree, Web3Forms, etc.
        Replace action="..." with your Formspree/Web3Forms endpoint.
      -->
      <form
        class="contact-form"
        action="https://formspree.io/f/mnjwwloo"
        method="POST"
        id="contact-form"
      >
        <div class="form-row">
          <div class="form-field">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
        </div>

        <div class="form-field">
          <label for="subject">Subject</label>
          <select id="subject" name="subject">
            <option value="">Select a topic…</option>
            <option>Consulting inquiry</option>
            <option>Research collaboration</option>
            <option>Advisory role</option>
            <option>Press & media</option>
            <option>Other</option>
          </select>
        </div>

        <div class="form-field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <div class="form-footer">
          <button type="submit" class="btn-primary" id="submit-btn">Send message</button>
          <p class="form-note">I reply within 48 hours.</p>
        </div>

        <div class="form-success" id="form-success" aria-live="polite">
          Message sent — I'll be in touch within 48 hours.
        </div>
      </form>
    </div>

    <!-- Right: direct links -->
    <div class="contact-right">
      <p class="section-label">Direct contact</p>

      <div class="contact-links">
        <a class="contact-link" href="mailto:your@email.com">
          <span class="contact-link-label">Email</span>
          <span class="contact-link-value">your@email.com</span>
        </a>
        <a class="contact-link" href="https://linkedin.com" target="_blank" rel="noopener">
          <span class="contact-link-label">LinkedIn</span>
          <span class="contact-link-value">linkedin.com/in/yourhandle</span>
        </a>
        <a class="contact-link" href="https://scholar.google.com" target="_blank" rel="noopener">
          <span class="contact-link-label">Google Scholar</span>
          <span class="contact-link-value">View profile →</span>
        </a>
        <a class="contact-link" href="https://orcid.org" target="_blank" rel="noopener">
          <span class="contact-link-label">ORCID</span>
          <span class="contact-link-value">0000-0000-0000-0000</span>
        </a>
        <a class="contact-link" href="https://researchgate.net" target="_blank" rel="noopener">
          <span class="contact-link-label">ResearchGate</span>
          <span class="contact-link-value">View profile →</span>
        </a>
      </div>
    </div>

  </div>

</BaseLayout>

<style>
  .contact-page {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 1100px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .contact-page { grid-template-columns: 3fr 2fr; }
  }

  /* Left */
  .contact-left {
    border-right: none;
    border-bottom: var(--border);
  }
  @media (min-width: 768px) {
    .contact-left { border-right: var(--border); border-bottom: none; }
  }

  .page-header {
    padding: var(--sp-8) var(--section-px) var(--sp-6);
    border-bottom: var(--border);
    display: flex; flex-direction: column; gap: var(--sp-3);
  }
  .page-title { font-family: var(--serif); font-size: clamp(2.2rem, 4vw, 3rem); font-weight: 300; line-height: 1.05; color: var(--ink); }
  .page-title em { font-style: italic; color: var(--accent); }
  .page-intro { font-size: 15px; color: var(--ink-muted); line-height: 1.8; font-weight: 300; max-width: 480px; }

  /* Form */
  .contact-form {
    padding: var(--sp-6) var(--section-px);
    display: flex; flex-direction: column; gap: var(--sp-3);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
  }
  @media (max-width: 500px) { .form-row { grid-template-columns: 1fr; } }

  .form-field {
    display: flex; flex-direction: column; gap: 0.4rem;
  }

  label {
    font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-muted); font-weight: 400;
  }

  input, select, textarea {
    font-family: var(--sans);
    font-size: 14px; font-weight: 300;
    color: var(--ink);
    background: white;
    border: var(--border);
    border-radius: 2px;
    padding: 10px 12px;
    width: 100%;
    transition: border-color 0.2s;
    outline: none;
    appearance: none;
  }
  input:focus, select:focus, textarea:focus {
    border-color: var(--accent);
  }
  textarea { resize: vertical; min-height: 140px; }

  .form-footer {
    display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
  }
  .form-note { font-size: 12px; color: var(--ink-muted); }

  .form-success {
    display: none;
    font-size: 14px; color: var(--accent);
    padding: 12px 16px;
    border: 1px solid var(--accent);
    border-radius: 2px;
    background: var(--accent-light);
  }
  .form-success.visible { display: block; }

  /* Right */
  .contact-right {
    padding: var(--sp-8) var(--section-px);
  }

  .contact-links {
    display: flex; flex-direction: column;
    margin-top: var(--sp-3);
  }

  .contact-link {
    display: flex; flex-direction: column; gap: 0.2rem;
    padding: 1rem 0;
    border-bottom: var(--border);
    text-decoration: none;
    transition: background 0.15s;
    border-radius: 2px;
  }
  .contact-link:last-child { border-bottom: none; }
  .contact-link:hover .contact-link-value { color: var(--accent); }

  .contact-link-label {
    font-size: 10px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ink-muted);
  }
  .contact-link-value {
    font-size: 14px; color: var(--ink); transition: color 0.2s;
  }
</style>

<script>
  // Progressive enhancement: AJAX submit so the page doesn't reload
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn  = document.getElementById('submit-btn') as HTMLButtonElement;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    // Only intercept if it's a real Formspree endpoint
    if (form.action.includes('YOUR_FORM_ID')) return; // fallback to normal submit
    e.preventDefault();
    btn.textContent = 'Sending…';
    btn.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' },
      });
      if (res.ok) {
        form.reset();
        success?.classList.add('visible');
        btn.style.display = 'none';
      } else {
        btn.textContent = 'Something went wrong — please email me directly.';
      }
    } catch {
      btn.textContent = 'Something went wrong — please email me directly.';
    }
  });
</script>
