---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useT, formatDateShort } from '../../../i18n/translations';

const lang = 'en' as const;
const tr = useT(lang);

const allPosts = await getCollection('blog-en', ({ data }) => !data.draft);
const posts    = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout lang={lang} title={tr.meta.blog_title} description={tr.meta.blog_desc}>
  <div class="blog-index">
    <header class="blog-header">
      <p class="eyebrow">Research log</p>
      <h1 class="blog-index-title">{tr.blog.page_title}</h1>
      <p class="blog-index-desc">{tr.blog.page_desc}</p>
    </header>
    <div class="post-list">
      {posts.map((post, i) => (
        <a class="post-row" href={`/en/blog/${post.slug}`}>
          <div class="post-row-left">
            <span class="post-num">{String(posts.length - i).padStart(2, '0')}</span>
          </div>
          <div class="post-row-main">
            <div class="post-row-meta">
              <span class="tag">{post.data.tag}</span>
              <span class="post-date">{formatDateShort(post.data.date, lang)}</span>
            </div>
            <div class="post-title">{post.data.title}</div>
            <div class="post-excerpt">{post.data.excerpt}</div>
          </div>
          <div class="post-arrow">→</div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
<style>
  .blog-index { max-width: 900px; margin: 0 auto; }
  .blog-header { padding: var(--sp-8) var(--section-px) var(--sp-6); border-bottom: var(--border); display: flex; flex-direction: column; gap: var(--sp-2); }
  .blog-index-title { font-family: var(--serif); font-size: clamp(2.4rem, 5vw, 3.5rem); font-weight: 300; line-height: 1.05; color: var(--ink); }
  .blog-index-desc { font-size: 15px; color: var(--ink-muted); max-width: 480px; line-height: 1.75; font-weight: 300; }
  .post-list { display: flex; flex-direction: column; }
  .post-row { display: grid; grid-template-columns: 48px 1fr 32px; gap: 1rem; align-items: start; padding: 2rem var(--section-px); border-bottom: var(--border); text-decoration: none; transition: background 0.2s; }
  @media (max-width: 500px) { .post-row { grid-template-columns: 1fr 24px; } .post-row-left { display: none; } }
  .post-row:hover { background: rgba(59,74,62,0.04); }
  .post-num { font-family: var(--serif); font-size: 1.4rem; font-weight: 300; color: var(--ink-faint); line-height: 1; }
  .post-row-main { display: flex; flex-direction: column; gap: 0.5rem; }
  .post-row-meta { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .post-date { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); }
  .post-title { font-family: var(--serif); font-size: clamp(1.1rem, 2.5vw, 1.4rem); font-weight: 400; line-height: 1.25; color: var(--ink); }
  .post-excerpt { font-size: 13px; color: var(--ink-muted); line-height: 1.65; }
  .post-arrow { font-size: 18px; color: var(--ink-faint); padding-top: 2px; transition: color 0.2s, transform 0.2s; }
  .post-row:hover .post-arrow { color: var(--ink); transform: translateX(3px); }
</style>
