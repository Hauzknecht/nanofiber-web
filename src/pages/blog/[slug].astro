---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Tell Astro which slugs exist at build time
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props:  { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${post.data.title} — Jana Nováková`} description={post.data.excerpt}>

  <article class="post">

    <!-- Back link -->
    <div class="post-back">
      <a href="/blog" class="btn-ghost" style="font-size:11px;">All articles</a>
    </div>

    <!-- Header -->
    <header class="post-header">
      <div class="post-header-meta">
        <span class="tag">{post.data.tag}</span>
        <time datetime={post.data.date.toISOString()} class="post-date">
          {formatDate(post.data.date)}
        </time>
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-excerpt">{post.data.excerpt}</p>
      <div class="post-byline">By {post.data.author}</div>
    </header>

    <!-- Cover image (optional) -->
    {post.data.coverImage && (
      <div class="post-cover">
        <img src={post.data.coverImage} alt={post.data.title} />
      </div>
    )}

    <!-- Article body -->
    <div class="post-body">
      <Content />
    </div>

    <!-- Footer nav -->
    <div class="post-footer">
      <a href="/blog" class="btn-primary">← Back to all articles</a>
      <a href="/contact" class="btn-ghost">Get in touch</a>
    </div>

  </article>

</BaseLayout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--section-px);
  }

  .post-back {
    padding: var(--sp-4) 0 0;
    border-bottom: var(--border);
    padding-bottom: var(--sp-3);
    margin-bottom: 0;
  }

  /* ── Header ── */
  .post-header {
    padding: var(--sp-6) 0 var(--sp-6);
    border-bottom: var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .post-header-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-date {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .post-title {
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 300;
    line-height: 1.08;
    color: var(--ink);
  }

  .post-excerpt {
    font-size: 16px;
    color: var(--ink-muted);
    line-height: 1.7;
    font-weight: 300;
    font-style: italic;
    font-family: var(--serif);
    border-left: 2px solid var(--ink-faint);
    padding-left: 1rem;
  }

  .post-byline {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  /* ── Cover image ── */
  .post-cover {
    margin: var(--sp-4) 0;
    border-radius: 3px;
    overflow: hidden;
    border: var(--border);
  }
  .post-cover img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
  }

  /* ── Body typography ── */
  .post-body {
    padding: var(--sp-6) 0;
    font-size: 16px;
    line-height: 1.85;
    color: var(--ink-muted);
    font-weight: 300;
    border-bottom: var(--border);
  }

  .post-body :global(h2) {
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 300;
    color: var(--ink);
    margin: 2.5rem 0 1rem;
    line-height: 1.2;
  }

  .post-body :global(h3) {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 2rem 0 0.75rem;
  }

  .post-body :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-body :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }

  .post-body :global(em) {
    font-style: italic;
    color: var(--accent);
    font-family: var(--serif);
  }

  .post-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-body :global(a:hover) { opacity: 0.75; }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .post-body :global(li) { margin-bottom: 0.4rem; }

  .post-body :global(blockquote) {
    border-left: 2px solid var(--ink-faint);
    margin: 2rem 0;
    padding: 0.5rem 0 0.5rem 1.5rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--ink);
  }

  .post-body :global(code) {
    background: var(--accent-light);
    color: var(--accent);
    padding: 2px 6px;
    border-radius: 2px;
    font-size: 13px;
    font-family: monospace;
  }

  .post-body :global(pre) {
    background: var(--ink);
    color: var(--cream);
    padding: 1.25rem;
    border-radius: 3px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .post-body :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
  }

  .post-body :global(hr) {
    border: none;
    border-top: var(--border);
    margin: 2.5rem 0;
  }

  /* ── Footer ── */
  .post-footer {
    padding: var(--sp-6) 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
</style>
