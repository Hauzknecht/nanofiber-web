---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ExpertiseStrip from "../components/ExpertiseStrip.astro";
import About from "../components/About.astro";
import BlogPreview from "../components/BlogPreview.astro";
import LocationSection from "../components/LocationSection.astro";

// ─── Edit your content here ───────────────────────────────
const heroData = {
  title: "Engineering beauty at the <em>nanoscale.</em>",
  description:
    "Research at the intersection of electrospinning, nanotechnology, and cosmetic science — creating next-generation delivery systems for skincare actives.",
  stats: [
    { num: "12+", label: "Publications" },
    { num: "5",   label: "Years research" },
    { num: "3",   label: "Industry projects" },
  ],
  latestPublication: {
    title:   "Electrospun nanofiber membranes as transdermal delivery vehicles for vitamin C derivatives",
    journal: "Journal of Cosmetic Science",
    year:    "2024",
    tag:     "Electrospinning",
  },
};

const aboutData = {
  body: [
    "I am a PhD researcher specialising in the application of <strong>electrospun nanofibers</strong> to cosmetic formulation science. My work bridges fundamental polymer chemistry with real-world cosmetic product innovation — exploring how sub-micron fiber architectures can transform the way actives interact with the skin barrier.",
    "Alongside my academic research, I work with cosmetic brands and ingredient companies as a <strong>scientific consultant</strong>, helping translate laboratory findings into viable product concepts.",
  ],
  institution: "Your University",
  location:    "Czech Republic",
  field:       "Nanotechnology · Cosmetics",
  // photoSrc: "/images/portrait.jpg",  ← uncomment and add your photo
};

const blogPosts = [
  {
    slug:    "nanofibers-vs-sheet-masks",
    title:   "Why nanofibers could replace conventional face masks",
    date:    "March 2025",
    excerpt: "Sheet masks are a $1.5B market. But their delivery efficiency is surprisingly limited. Here's what nanofibers change.",
    tag:     "Industry",
  },
  {
    slug:    "electrospinning-parameters",
    title:   "Electrospinning parameters for cosmetic-grade fibers",
    date:    "January 2025",
    excerpt: "A practical guide to voltage, flow rate, and collector distance when working with skin-compatible polymers.",
    tag:     "Technical",
  },
  {
    slug:    "retinol-encapsulation",
    title:   "Retinol encapsulation: the nanofiber approach",
    date:    "November 2024",
    excerpt: "Retinol is notoriously unstable. This is how nanofiber matrices offer a novel stabilisation strategy.",
    tag:     "Research",
  },
];
---

<BaseLayout
  title="Martina Říhová - Nanofiber Research"
  description="PhD researcher specialising in electrospun nanofibers for cosmetic applications."
>
  <Hero {...heroData} />
  <ExpertiseStrip />
  <About {...aboutData} />
  <BlogPreview posts={blogPosts} />
  <LocationSection
    lat={49.1951}
    lng={16.6068}
    cityName="Brno"
    country="Czech Republic"
  />
</BaseLayout>
