---
// Detect browser language and redirect, defaulting to /en/
---
<html>
<head>
  <meta charset="UTF-8" />
  <title>Redirecting…</title>
  <script>
    const lang = (navigator.language || 'en').startsWith('cs') ? 'cs' : 'en';
    window.location.replace('/' + lang + '/');
  </script>
  <!-- Fallback for no-JS -->
  <meta http-equiv="refresh" content="0; url=/en/" />
  <link rel="canonical" href="/en/" />
</head>
<body></body>
</html>
