---
import '../styles/global.css';

const { title = "Website" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body class="bg-white text-gray-900">
    <main class="max-w-5xl mx-auto p-6">
      <slot />
    </main>
  </body>
</html>